{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "cover_image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e9\u05e2\u05e8"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "owner_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "private",
      "description": "\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "production",
        "social"
      ],
      "default": "social",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 - \u05d4\u05e4\u05e7\u05d4 \u05d0\u05d5 \u05d7\u05d1\u05e8\u05ea\u05d9"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd \u05e9\u05dc \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 (\u05d0\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05e0\u05de\u05e9\u05da \u05d9\u05d5\u05ea\u05e8 \u05de\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "cancelled"
      ],
      "default": "active",
      "description": "\u05de\u05e6\u05d1 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 - \u05e4\u05e2\u05d9\u05dc/\u05d4\u05e1\u05ea\u05d9\u05d9\u05dd/\u05d1\u05d5\u05d8\u05dc"
    },
    "datePollEnabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05e9 \u05e1\u05e7\u05e8 \u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05e2\u05d9\u05dc"
    },
    "locationPollEnabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05e9 \u05e1\u05e7\u05e8 \u05de\u05e7\u05d5\u05dd \u05e4\u05e2\u05d9\u05dc"
    },
    "participationCost": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d1\u05d0\u05d9\u05e8\u05d5\u05e2 (\u05dc\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05d9\u05dd)"
    },
    "hidePaymentsFromMembers": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e1\u05ea\u05d9\u05e8 \u05d8\u05d0\u05d1 \u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd \u05de\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05e8\u05d2\u05d9\u05dc\u05d9\u05dd"
    },
    "visibleTabs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05d8\u05d0\u05d1\u05d9\u05dd \u05d4\u05d2\u05dc\u05d5\u05d9\u05d9\u05dd \u05dc\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05e8\u05d2\u05d9\u05dc\u05d9\u05dd"
    },
    "paymentMethod": {
      "type": "string",
      "enum": [
        "bit",
        "paybox",
        "bank_transfer"
      ],
      "description": "\u05d0\u05de\u05e6\u05e2\u05d9 \u05ea\u05e9\u05dc\u05d5\u05dd \u05de\u05d5\u05e2\u05d3\u05e3 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 (\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "paymentMethods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bit",
          "paybox",
          "bank_transfer"
        ]
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d0\u05de\u05e6\u05e2\u05d9 \u05ea\u05e9\u05dc\u05d5\u05dd \u05de\u05d0\u05d5\u05e9\u05e8\u05d9\u05dd \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "paymentPhone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd \u05d1\u05d1\u05d9\u05d8/\u05e4\u05d9\u05d9\u05d1\u05d5\u05e7\u05e1"
    },
    "bankDetails": {
      "type": "object",
      "properties": {
        "bankName": {
          "type": "string",
          "description": "\u05e9\u05dd \u05d4\u05d1\u05e0\u05e7"
        },
        "branchNumber": {
          "type": "string",
          "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05e0\u05d9\u05e3"
        },
        "accountNumber": {
          "type": "string",
          "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05df"
        },
        "accountHolder": {
          "type": "string",
          "description": "\u05e9\u05dd \u05d1\u05e2\u05dc \u05d4\u05d7\u05e9\u05d1\u05d5\u05df"
        }
      },
      "description": "\u05e4\u05e8\u05d8\u05d9 \u05d7\u05e9\u05d1\u05d5\u05df \u05d1\u05e0\u05e7 \u05dc\u05d4\u05e2\u05d1\u05e8\u05d4 \u05d1\u05e0\u05e7\u05d0\u05d9\u05ea"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d7\u05d5\u05d6\u05e8 \u05e2\u05dc \u05e2\u05e6\u05de\u05d5 (\u05d0\u05d9\u05e8\u05d5\u05e2 \u05e1\u05d3\u05e8\u05ea\u05d9)"
    },
    "notifyOnRsvp": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05e9\u05dc\u05d5\u05d7 \u05d4\u05ea\u05e8\u05d0\u05d4 \u05dc\u05de\u05d0\u05e8\u05d2\u05df \u05db\u05d0\u05e9\u05e8 \u05de\u05d9\u05e9\u05d4\u05d5 \u05de\u05d2\u05d9\u05d1 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d2\u05e2\u05d4"
    }
  },
  "required": [
    "title",
    "owner_id"
  ]
}