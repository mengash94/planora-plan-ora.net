{
  "name": "SystemMessage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 (\u05ea\u05d5\u05de\u05da Markdown)"
    },
    "type": {
      "type": "string",
      "enum": [
        "maintenance",
        "new_feature",
        "update",
        "announcement",
        "warning",
        "info"
      ],
      "default": "info",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "targetAudience": {
      "type": "string",
      "enum": [
        "all",
        "new_users",
        "active_users",
        "inactive_users",
        "admins",
        "specific_users"
      ],
      "default": "all",
      "description": "\u05e7\u05d4\u05dc \u05d4\u05d9\u05e2\u05d3"
    },
    "specificUserIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d6\u05d4\u05d9 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd (\u05d0\u05dd \u05e7\u05d4\u05dc \u05d4\u05d9\u05e2\u05d3 \u05d4\u05d5\u05d0 specific_users)"
    },
    "displayMode": {
      "type": "string",
      "enum": [
        "banner",
        "popup",
        "notification",
        "all"
      ],
      "default": "banner",
      "description": "\u05d0\u05d5\u05e4\u05df \u05d4\u05e6\u05d2\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "dismissible": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d9\u05ea\u05df \u05dc\u05e1\u05d2\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "requireConfirm": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e7\u05e8\u05d9\u05d0\u05d4"
    },
    "startDate": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05ea \u05d4\u05e6\u05d2\u05d4"
    },
    "endDate": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05e6\u05d2\u05d4"
    },
    "scheduledFor": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05dc\u05d9\u05d7\u05d4 \u05de\u05ea\u05d5\u05d6\u05de\u05e0\u05ea (push notification)"
    },
    "sendPush": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05e9\u05dc\u05d5\u05d7 push notification"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "viewCount": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e6\u05e4\u05d9\u05d5\u05ea"
    },
    "dismissedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05e1\u05d2\u05e8\u05d5 \u05d0\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "confirmedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05d0\u05d9\u05e9\u05e8\u05d5 \u05e7\u05e8\u05d9\u05d0\u05d4"
    }
  },
  "required": [
    "title",
    "content",
    "type"
  ]
}