{
  "name": "NotiToken",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "platform": {
      "type": "string",
      "enum": [
        "mobile",
        "android",
        "ios",
        "web"
      ],
      "description": "\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05ea \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "provider": {
      "type": "string",
      "enum": [
        "fcm",
        "onesignal",
        "apns"
      ],
      "description": "\u05e1\u05e4\u05e7 \u05d4\u05d4\u05ea\u05e8\u05d0\u05d5\u05ea"
    },
    "token": {
      "type": "string",
      "description": "\u05d8\u05d5\u05e7\u05df \u05d4\u05d4\u05ea\u05e8\u05d0\u05d5\u05ea (FCM/APNS/OneSignal)"
    },
    "appVersion": {
      "type": "string",
      "description": "\u05d2\u05e8\u05e1\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "locale": {
      "type": "string",
      "description": "\u05e9\u05e4\u05ea \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d8\u05d5\u05e7\u05df \u05e4\u05e2\u05d9\u05dc"
    },
    "lastUsed": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05d9\u05de\u05d5\u05e9 \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "userId",
    "platform",
    "provider",
    "token"
  ]
}