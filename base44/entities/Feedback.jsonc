{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05de\u05e9\u05d5\u05d1"
    },
    "userName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "userEmail": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "feedbackType": {
      "type": "string",
      "enum": [
        "general",
        "suggestion",
        "bug_report",
        "question"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05d5\u05d1"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05e9\u05d5\u05d1"
    },
    "message": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05e9\u05d5\u05d1"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "resolved",
        "archived"
      ],
      "default": "new",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05e9\u05d5\u05d1"
    },
    "adminResponse": {
      "type": "string",
      "description": "\u05ea\u05d2\u05d5\u05d1\u05ea \u05de\u05e0\u05d4\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea"
    },
    "responseDate": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05ea\u05df \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4"
    }
  },
  "required": [
    "userId",
    "userEmail",
    "feedbackType",
    "title",
    "message"
  ]
}