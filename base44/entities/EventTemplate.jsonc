{
  "name": "EventTemplate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9",
        "\u05d7\u05d1\u05e8\u05d9\u05dd",
        "\u05e2\u05d1\u05d5\u05d3\u05d4",
        "\u05de\u05e1\u05d9\u05d1\u05d4",
        "\u05d7\u05d5\u05e5",
        "\u05d0\u05d7\u05e8"
      ],
      "default": "\u05d0\u05d7\u05e8",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05dc \u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "cover_image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e9\u05e2\u05e8 \u05dc\u05ea\u05d1\u05e0\u05d9\u05ea"
    },
    "default_tasks": {
      "type": "array",
      "description": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05d9\u05d9\u05d5\u05d5\u05e6\u05e8\u05d5 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05d1\u05e2\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05d4\u05ea\u05d1\u05e0\u05d9\u05ea",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
          },
          "description": {
            "type": "string",
            "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
          },
          "suggested_assignee_role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "member",
              "any"
            ],
            "default": "any",
            "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e9\u05d9\u05d5\u05da (\u05e8\u05e7 \u05db\u05d4\u05e0\u05d7\u05d9\u05d4)"
          },
          "due_offset_days": {
            "type": "number",
            "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd \u05d9\u05d7\u05e1\u05d9\u05ea \u05dc\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 (\u05e9\u05dc\u05d9\u05dc\u05d9 = \u05dc\u05e4\u05e0\u05d9, \u05d7\u05d9\u05d5\u05d1\u05d9 = \u05d0\u05d7\u05e8\u05d9)"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  },
  "required": [
    "title"
  ]
}