{
  "name": "Task",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 (\u05ea\u05d5\u05d0\u05dd \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "eventId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 (camelCase \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d7\u05d3\u05e9)"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ],
      "default": "todo",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "priority": {
      "type": "string",
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3 (\u05ea\u05d5\u05d0\u05dd \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "dueDate": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3 (camelCase \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d7\u05d3\u05e9)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e0\u05d5\u05e6\u05e8 \u05d1\u05ea\u05d0\u05e8\u05d9\u05da (\u05d0\u05d6\u05d5\u05e8 \u05d6\u05de\u05df \u05d9\u05e9\u05e8\u05d0\u05dc)"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e2\u05d5\u05d3\u05db\u05df \u05d1\u05ea\u05d0\u05e8\u05d9\u05da (\u05d0\u05d6\u05d5\u05e8 \u05d6\u05de\u05df \u05d9\u05e9\u05e8\u05d0\u05dc)"
    },
    "assignee_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 (\u05ea\u05d5\u05d0\u05dd \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "assigneeId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 (camelCase \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d7\u05d3\u05e9)"
    },
    "assignee_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d9\u05d3\u05e0\u05d9 \u05e9\u05dc \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e7\u05d9\u05d9\u05dd \u05d1\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd (\u05ea\u05d5\u05d0\u05dd \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "assigneeName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d9\u05d3\u05e0\u05d9 \u05e9\u05dc \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 (camelCase \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d7\u05d3\u05e9)"
    },
    "isHidden": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05de\u05d5\u05e1\u05ea\u05e8\u05ea \u05de\u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d4\u05e8\u05d2\u05d9\u05dc\u05d9\u05dd (\u05e8\u05e7 \u05de\u05d0\u05e8\u05d2\u05e0\u05d9\u05dd \u05e8\u05d5\u05d0\u05d9\u05dd)"
    }
  },
  "required": [
    "title",
    "event_id"
  ]
}