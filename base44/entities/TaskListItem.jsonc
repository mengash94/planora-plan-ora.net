{
  "name": "TaskListItem",
  "type": "object",
  "properties": {
    "listId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05e9\u05d0\u05dc\u05d9\u05d4 \u05e9\u05d9\u05d9\u05da \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "text": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "isDone": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d4\u05d5\u05e9\u05dc\u05dd"
    },
    "assigneeId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d9\u05d8 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "dueDate": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3 \u05dc\u05e4\u05e8\u05d9\u05d8 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "orderIndex": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e6\u05d2\u05ea \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4"
    }
  },
  "required": [
    "listId",
    "text"
  ]
}